# Set ENVIRONMENT=production when deploying. Production requires NSIQ_API_KEY.
ENVIRONMENT=development
NSIQ_API_KEY=
NSIQ_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated exact domains or suffix patterns, e.g. example.com,.example.org.
NSIQ_ALLOWED_TARGETS=
NSIQ_RATE_LIMIT_PER_MINUTE=20
NSIQ_DATABASE_PATH=data/assessments.db

# AI enrichment is opt-in. Uploaded log excerpts may contain sensitive data.
NSIQ_GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
